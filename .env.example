# Merx reference server configuration. Copy to .env (git-ignored) and fill in.
# Every payment provider is opt-in. With nothing set, Merx runs offline with the
# in-memory store and fictional bank-transfer demo instructions.

PORT=3000
MERX_CATALOG=examples/stores/tatra-coffee/catalog.json
# MERX_PRIVATE_KEY=            # PEM, or use MERX_KEY_FILE=.merx/store-key.pem
MERX_STORE=sqlite:.merx/merx.db
MERX_PUBLIC_URL=https://your-store.example
MERX_ADMIN_TOKEN=              # >= 32 random characters, e.g. `openssl rand -hex 32`
MERX_REQUIRE_ORDER_TOKEN=1
# MERX_DEFAULT_PAYMENT_METHOD=stripe_checkout
# MERX_DISABLE_DEMO_TRANSFER=1
# MERX_RECONCILE_INTERVAL_SECONDS=300
# MERX_WEBHOOK_URL=            # receives order.created and payment.updated

# Stripe Checkout (test mode keys only unless STRIPE_ALLOW_LIVE=1)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCIES=EUR
# STRIPE_COUNTRIES=SK,CZ,AT,DE
# STRIPE_ALLOW_LIVE=0

# GoPay (sandbox unless GOPAY_ENVIRONMENT=production)
# GOPAY_CLIENT_ID=
# GOPAY_CLIENT_SECRET=
# GOPAY_GOID=
# GOPAY_ENVIRONMENT=sandbox
# GOPAY_LANG=SK
